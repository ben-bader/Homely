# Create a boost purchase
POST {{baseUrl}}/boost
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "sellerId": "06dde16f-482d-4965-be69-8b852934c685",
  "propertyId": "01965929-d774-4d61-8783-58b16f97d7f6",
  "amount": 22.99,
  "currency": "USD",
  "durationDays": 7,
  "status": "PENDING",
  "paymentProviderRef": "txn_12345"
}

###
# Get boost by ID
GET {{baseUrl}}/admin/boosts
Authorization: Bearer {{token}}

###

GET {{baseUrl}}/boost/f1dcf007-204b-476d-b69c-e0412fd628df
Authorization: Bearer {{token}}

###
# Get boosts by status
GET {{baseUrl}}/boost/status?status=PENDING
Authorization: Bearer {{token}}

###
# Get boosts by status (COMPLETED)
GET {{baseUrl}}/boost?status=COMPLETED
Authorization: Bearer {{token}}

###
# Get boosts by seller ID

# Get boosts by seller ID (different seller)
GET {{baseUrl}}/boost?sellerId=13f049ae-1e58-4a1c-bfe5-daa0a90137b2
Authorization: Bearer {{token}}

