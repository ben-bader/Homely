### Register a new user
@baseUrl = http://localhost:8082/api

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "bichoufarouk@gmail.com",
    "password": "Farou9123",
    "name": "Farouk Bichou",
    "phone": "0601020304",
    "role": "ADMIN"
}
###
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "testuser1@example.com",
    "password": "Password123",
    "name": "Test User 1",
    "phone": "1234567890",
    "role": "CLIENT"
}

###

###
# @name auth
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "benbader1231@gmail.com",
  "password": "Bader12345"
}

###

# Set token variable from login response
@token = {{auth.response.body.token}}

###
POST {{baseUrl}}/users/reports
Content-Type: application/json
Authorization: Bearer  {{token}}

{
  "reporterId": "06dde16f-482d-4965-be69-8b852934c685",
  "reportedUserId": "1cc506d3-8e96-4ee6-9d6a-547111cca005",
  "reportedPropertyId": "12372705-7110-432e-b150-1ed11712a3d7",
  "reason": "Suspesious listing",
  "status": "OPEN",
  "reviewedByAdminId": null
}
