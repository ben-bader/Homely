### Register a new user
@baseUrl = http://localhost:8082/api

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "testAdmin@example.com",
    "password": "Fanou9123",
    "name": "Fanou9",
    "phone": "1234567890",
    "role": "ADMIN"
}
###
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "testuser2@example.com",
    "password": "password",
    "name": "Test User",
    "phone": "1234567890",
    "role": "ADMIN"
}

###
POST {{baseUrl}}/admin/reports
Content-Type: application/json
Accept: application/json

{
  "reporterId": "80a53c11-d7fb-4cf4-a858-683fb4d6e84d",
  "reportedUserId": "0f4ae0a4-9a3a-4648-871a-d3042f6b2cf3",
  "reportedPropertyId": "a6f45a0f-2328-47f1-be16-dfdf0e8698ed",
  "reason": "listing",
  "status": "OPEN",
  "reviewedByAdminId": null
}

###
# @name auth
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "bennanibader2006@gmail.com",
  "password": "123456"
}

###

# Set token variable from login response
@token = {{auth.response.body.token}}

###

GET {{baseUrl}}/test/whoami
Authorization: Bearer  {{token}}

###
PUT {{baseUrl}}/profiles/4a8d8ed8-b19f-49e7-afc2-06a6ed0716c9
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userId": "4a8d8ed8-b19f-49e7-afc2-06a6ed0716c9",
  "bio": " looking for a cozy home.",
  "address": " Casablanca, Morocco",
  "verified": false,
  "idDocumentUrl": "https://storage.homely.com/docs/id-999.pdf"
}
###

# Create an apartment
POST {{baseUrl}}/properties
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Beautiful 2BR Apartment in Downtown",
  "description": "Spacious apartment with modern amenities, located in the heart of the city. Features include hardwood floors, updated kitchen, and large windows with natural light.",
  "price": 150000,
  "address": "123 Main Street, Casablanca, Morocco",
  "listingType": "RENT",
  "longitude": -7.589843,
  "latitude": 33.573110,
  "propertyType": "APARTMENT",
  "currency": "USD",
  "status": "AVAILABLE",
  "apartment": {
    "bedrooms": 2,
    "bathrooms": 1,
    "floor": 5,
    "hasElevator": true
  }
}

###

# Get all properties
GET {{baseUrl}}/properties
Authorization: Bearer {{token}}

###

# Search properties
GET {{baseUrl}}/properties/search?listingType=RENT
Authorization: Bearer {{token}}

###

# Create a conversation
POST {{baseUrl}}/chat/conversations/d38223a9-7d13-4a20-a887-6c12cdc3390d
Content-Type: application/json
Authorization: Bearer {{token}}

###

# Get user conversations (replace with actual userId)
GET {{baseUrl}}/chat/conversations?userId=4a8d8ed8-b19f-49e7-afc2-06a6ed0716c9

###
GET {{baseUrl}}/chat/messages?conversationId=b8883725-ff54-410a-830e-ff7d8fa0f318
 
