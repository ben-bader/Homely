### Register a new user
@baseUrl = http://localhost:8082/api


###

###
# @name auth
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "faroukbichou1@gmail.com",
  "password": "Farouk123"
}

###

# Set token variable from login response
@token = {{auth.response.body.accessToken}}

###
GET {{baseUrl}}/admin/users
Content-Type: application/json
Authorization: Bearer  {{token}}

###
GET {{baseUrl}}/log-activities
Authorization: Bearer  {{token}}

###
PUT {{baseUrl}}/profiles/4a8d8ed8-b19f-49e7-afc2-06a6ed0716c9
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userId": "4a8d8ed8-b19f-49e7-afc2-06a6ed0716c9",
  "bio": " looking for a cozy home.",
  "address": " Casablanca, Morocco",
  "verified": false,
  "idDocumentUrl": "https://storage.homely.com/docs/id-999.pdf"
}
###

# Create an apartment
POST {{baseUrl}}/properties
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Beautiful 2BR Apartment in Downtown",
  "description": "Spacious apartment with modern amenities, located in the heart of the city. Features include hardwood floors, updated kitchen, and large windows with natural light.",
  "price": 150000,
  "address": "123 Main Street, Casablanca, Morocco",
  "listingType": "RENT",
  "longitude": -7.589843,
  "latitude": 33.573110,
  "propertyType": "APARTMENT",
  "currency": "USD",
  "status": "AVAILABLE",
  "apartment": {
    "bedrooms": 2,
    "bathrooms": 1,
    "floor": 5,
    "hasElevator": true
  }
}

