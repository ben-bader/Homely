### Create a House
POST {{baseUrl}}/properties
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Modern 3BR House with Garage",
  "description": "Beautiful family house located in a quiet neighborhood.",
  "price": 250000,
  "address": "45 Palm Street, Casablanca, Morocco",
  "listingType": "SELL",
  "longitude": -7.600000,
  "latitude": 33.580000,
  "propertyType": "HOUSE",
  "currency": "USD",
  "status": "AVAILABLE",
  "house": {
    "bedrooms": 3,
    "bathrooms": 2,
    "hasGarage": true,
    "landAreaSqm": 250.0
  }
}
###
### Create a Villa
POST {{baseUrl}}/properties
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Luxury 5BR Villa with Pool",
  "description": "Spacious luxury villa with private pool and garden.",
  "price": 750000,
  "address": "12 Ocean View Road, Casablanca, Morocco",
  "listingType": "RENT",
  "longitude": -7.620000,
  "latitude": 33.590000,
  "propertyType": "VILLA",
  "currency": "USD",
  "status": "AVAILABLE",
  "villa": {
    "bedrooms": 5,
    "bathrooms": 4,
    "landAreaSqm": 500.0,
    "hasPool": true
  }
}
